FROM ubuntu
WORKDIR /app
RUN apt update
RUN apt install -y openjdk-21-jdk
ADD https://get.jenkins.io/war-stable/2.580.1/jenkins.war .
# Here the ENTRYPOINT will change the ubuntu container default process to jenkins process and it will behave as a jenkins container
# This cannot be changed while running the container
ENTRYPOINT ["java","-jar","jenkins.war"]
